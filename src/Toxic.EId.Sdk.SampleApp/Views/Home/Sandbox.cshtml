@{
    ViewData["Title"] = "Sandbox";
}

@section Styles {
    <link rel="stylesheet" href="~/css/sandbox.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/sandbox.js" asp-append-version="true"></script>
}

<h1>@ViewData["Title"]</h1>
<p>Refer to the <a href="https://docs.grandid.com">eID documentation</a> for an explanation of the parameters.</p>
<div class="col2">
  <fieldset>
    <legend>Authenticate options</legend>
    <label for="authMessage">authMessage</label><br />
    <input type="text" id="authMessage" value="" />
  </fieldset>
  <br />
  <fieldset>
    <legend>Sign options</legend>
    <label for="userVisibleData">userVisibleData</label><br />
    <textarea id="userVisibleData"></textarea><br />
    <label for="userNonVisibleData">userNonVisibleData</label><br />
    <input type="text" id="userNonVisibleData" value="" /><br />
    <label for="userVisibleDataFormat">userVisibleDataFormat</label><br />
    <select id="userVisibleDataFormat">
      <option value="plaintext">plaintext</option>
      <option value="simpleMarkdownV1">simpleMarkdownV1</option>
    </select>
  </fieldset>
</div>
<div class="col1">
  <fieldset>
    <legend>Gui options</legend>
    <label for="gui"><input type="checkbox" id="gui" value="gui" />gui</label><br />
    <label for="qr"><input type="checkbox" id="qr" value="qr" />qr</label><br />
    <label for="allowFingerPrintAuth"><input type="checkbox" id="allowFingerPrintAuth" value="allowFingerPrintAuth" />allowFingerPrintAuth</label><br />
    <label for="allowFingerPrintSign"><input type="checkbox" id="allowFingerPrintSign" value="allowFingerPrintSign" />allowFingerPrintSign</label><br />
    <label for="callbackUrl">callbackUrl</label><br />
    <input type="text" id="callbackUrl" value="https://localhost:7271/auth/callback" />
  </fieldset>
  <br />
  <fieldset>
    <legend>BankId app options</legend>
    <label for="returnUrl">returnUrl</label><br />
    <input type="text" id="returnUrl" value="https://localhost:7271/" />
  </fieldset>
</div>
<fieldset>
  <legend>Device mode</legend>
  <label for="mobileBankId"><input type="checkbox" id="mobileBankId" value="mobileBankId" />mobileBankId</label><br />
  <label for="desktopBankId"><input type="checkbox" id="desktopBankId" value="desktopBankId" />desktopBankId</label><br />
  <label for="thisDevice"><input type="checkbox" id="thisDevice" value="thisDevice" />thisDevice</label><br />
</fieldset>
<br />
<img id="qrImg" style="display:none" />
<pre id="result" style="display:none"></pre>
<button id="authenticate">Authenticate/sign with BankID</button>
